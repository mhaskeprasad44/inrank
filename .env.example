# ========================================================
# INRANK TECHNOLOGIES - ENVIRONMENT CONFIGURATION
# ========================================================
# Optional: GEMINI_API_KEY (Only needed if enabling live Gemini API generation for SEO audits)
# GEMINI_API_KEY=""

# Optional: APP_URL (Defaults automatically to https://inranktech.com)
# APP_URL="https://inranktech.com"

# ========================================================
# GMAIL SMTP SERVER CONFIGURATION (smtp.gmail.com)
# ========================================================
# Form submissions will be sent directly through Google's SMTP server to inranktech@gmail.com.
# NOTE: Google requires a 16-character "App Password" (NOT your regular password).
# Generate at: https://myaccount.google.com/apppasswords (Requires 2-Step Verification ON)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=inranktech@gmail.com
SMTP_PASS=""
EMAIL_TO=inranktech@gmail.com
