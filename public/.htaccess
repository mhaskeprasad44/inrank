# ==============================================================================
# Inrank Technologies - High-Performance Apache & LiteSpeed Configuration
# Optimized for Google Search Console (www.inranktech.com) & Core Web Vitals
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Canonical Domain: Force WWW (inranktech.com -> www.inranktech.com)
  RewriteCond %{HTTP_HOST} ^inranktech\.com$ [NC]
  RewriteRule ^(.*)$ https://www.inranktech.com/$1 [R=301,L]

  # 3. 301 Permanent Redirects for Legacy / Consolidated Pages
  RewriteRule ^portfolio(\.html)?$ /our-work.html [R=301,L]
  RewriteRule ^case-studies/(.+)\.html$ /our-work/$1.html [R=301,L]
  RewriteRule ^case-studies/(.+)$ /our-work/$1.html [R=301,L]

  # 4. Service Pages trailing slash routing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/public/services/$1/index.html -f
  RewriteRule ^services/([^/]+)/?$ /public/services/$1/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/public/services/$1.html -f
  RewriteRule ^services/([^/]+)/?$ /public/services/$1.html [L]
</IfModule>

# ==============================================================================
# MIME Types Configuration
# ==============================================================================
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# ==============================================================================
# GZIP / Deflate Compression
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ==============================================================================
# Browser Cache-Control Headers
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & Sitemaps: Revalidate immediately so changes are indexed rapidly
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"

  # Static Assets: Long cache
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
